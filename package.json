{
	"name": "obsidian-resolution-random-tables",
	"version": "0.1.1",
	"description": "Random tables, oracle and task rolls from tables in your vault, written into the note with inline code like `pick:loot`, `oracle:+` and `task:4`",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:vault": "npm run build && node scripts/copy-to-vault.mjs"
	},
	"keywords": [],
	"author": "Alicia Wilkerson",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "^6.12.1",
		"@codemirror/state": "^6.4.1",
		"@codemirror/view": "^6.34.1",
		"@eslint/js": "^9.39.4",
		"@lezer/common": "^1.2.3",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.2.4"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/matalina/obsidian-resolution-random-tables.git"
	}
}
